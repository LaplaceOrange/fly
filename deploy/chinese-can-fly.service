[Unit]
Description=中国人能飞实时起飞服务
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chinese-can-fly
Group=chinese-can-fly
WorkingDirectory=/var/lib/chinese-can-fly
EnvironmentFile=/etc/chinese-can-fly.env
ExecStart=/opt/chinese-can-fly/chinese-can-fly
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s

StateDirectory=chinese-can-fly
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/chinese-can-fly

[Install]
WantedBy=multi-user.target

